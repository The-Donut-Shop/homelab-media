# Copy to .env and fill in. .env is git-ignored: never commit real values.

# ── host ──────────────────────────────────────────────────────────────────────
PUID=1000
PGID=1000
TZ=Asia/Kolkata
# app state (databases, settings) - one sub-folder per app, NOT in this repo
APPDATA=/home/you/appdata
# the single data root mounted as /data in every container:
#   ${DATA}/downloads/{torrents,soulseek,cwa-ingest}   ${DATA}/media/{movies,series,music,books,audiobooks,podcasts}
DATA=/mnt/storage/data

# ── addresses ─────────────────────────────────────────────────────────────────
# your public domain (services are published through the homelab-edge repo)
DOMAIN=example.com
# how you reach the server privately (LAN IP, Tailscale IP or hostname)
LAN_HOST=192.168.1.10
HOMEPAGE_ALLOWED_HOSTS=home.example.com,192.168.1.10:3005
JELLYFIN_PUBLIC_URL=https://media.example.com
NAVIDROME_PUBLIC_URL=https://music.example.com
BOOKS_PUBLIC_URL=https://books.example.com

# ── credentials / API keys (generated by each app; copy them here) ───────────
QBIT_USERNAME=admin
QBIT_PASSWORD=change-me
SLSKD_API_KEY=generate-32+-random-chars
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
SEERR_API_KEY=
JELLYFIN_API_KEY=
LASTFM_API_KEY=
LASTFM_SECRET=
MALOJA_PASSWORD=change-me
